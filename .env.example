# go2rtc-viewer ローカル設定（テンプレート）
#   cp .env.example .env  したうえで .env に「実際の」LAN の値を記入してください。
#   .env は .gitignore 済みで、実IP・資格情報を置く唯一の場所です。
#
# 消費のされ方:
#   - start.sh が set -a で読み込み、go2rtc にプロセス環境変数として渡します。
#     go2rtc は go2rtc.yaml 内の ${VAR} を os.LookupEnv で解決します（.env 自体は読みません）。
#   - gen-config.sh が cameras.template.json -> cameras.json（git管理外）を生成します。
#   - recordings/server.js・download-cli.js は内蔵ローダでこの .env を読み、ONVIF_*（無ければ DVR_*）を取得します。
#
# 注意: これは「リポジトリ衛生」であって実行時の秘匿ではありません。ブラウザは cameras.json を
# 取得するため、カメラ IP は LAN 上の DevTools からは見えます。狙いは、共有されるコミット履歴に
# LAN 構成・資格情報を残さないことです。

# --- カメラ（RTSP ソース。RTSP 対応の IP カメラなら何でも可） ----------------
# 値は機器ごとに異なります。ここは空のままにし、実値は .env に記入してください。
CAM_IP=                      # カメラの LAN IP
RTSP_USER=admin              # RTSP ユーザー名（工場出荷時の値から変更すること）
RTSP_PASS=                   # RTSP パスワード（必ず強固な値を設定。空は危険）
# サブ（低解像度）/ メイン（高解像度）ストリームの RTSP パス。機種ごとに異なります。例:
#   ONVIF/汎用  : /stream2                      /stream1
#   Hikvision   : /Streaming/Channels/102       /Streaming/Channels/101
#   Dahua       : /cam/realmonitor?channel=1&subtype=1   ...&subtype=0
CAM_PATH_SUB=                # サブ（低解像度・軽量な既定表示）ストリームのパス
CAM_PATH_HD=                 # メイン（高解像度）ストリームのパス
# カメラを増やす場合は go2rtc.yaml に cam2 / cam2_hd を定義し、対応する値をここに追加。

# --- 録画バックエンド（任意） ----------------------------------------------
# recordings/ の既定バックエンドは ONVIF Profile G（ベンダー非依存の録画検索＋再生）です。
# 切替: RECORDINGS_BACKEND=onvif|netsdk（既定 onvif）。netsdk は塚本無線 OEM XVR 等向けの
#       レガシー flv.cgi クライアントで、オプトインのフォールバックとして残しています。
# 注意: いずれの経路も実機の Profile G ハードウェアでは未検証です（手元の機体は /onvif/* が
#       404）。詳細・制約は recordings/README.md / README.ja.md を参照。録画を使わない場合は空可。
RECORDINGS_BACKEND=onvif     # onvif（既定・推奨）| netsdk（レガシー flv.cgi フォールバック）

# ONVIF Profile G 接続先・資格情報（既定バックエンド）:
ONVIF_HOST=                  # ONVIF NVR/DVR の IP / ホスト（host:port も可。port 既定 80）
ONVIF_USER=admin             # ONVIF ユーザー名（WS-Security / HTTP-Digest / Basic 共通）
ONVIF_PASS=                  # ONVIF パスワード（強固な値を設定。空文字も可）
# 任意（必要時のみアンコメント）:
#ONVIF_DEVICE_PATH=/onvif/device_service  # Device サービスの入口パス（非標準機の上書き用）
#ONVIF_PORT=80                            # ONVIF ポート（host:port 指定が無い場合の明示）
#ONVIF_HONOR_XADDR=false                  # true で GetServices が広告する XAddr をそのまま使用
#                                          （既定 false: 広告 XAddr は設定 host:port に書換え）

# レガシー（netsdk フォールバック専用。ONVIF_* が無いとき DVR_* が代替として尊重されます）:
#   ONVIF_HOST←DVR_HOST / ONVIF_USER←DVR_USER / ONVIF_PASS←DVR_PASS のフォールバック順。
#   DVR_PASS='' の空文字許容セマンティクスは維持されます。
DVR_HOST=                    # （レガシー）DVR の IP / ホスト（host:port も可）
DVR_USER=admin               # （レガシー）DVR ユーザー名
DVR_PASS=                    # （レガシー）DVR パスワード（強固な値を設定）
#DVR_DEV=XVR                 # （レガシー・netsdk のみ）DEV 文字列。ONVIF では未使用
#DVR_VER=1.0                 # （レガシー・netsdk のみ）VER 文字列。ONVIF では未使用
#DVR_MAX_CHN=9               # （レガシー・netsdk のみ）最大ch数。ONVIF では録画一覧から導出

BIND_ADDR=127.0.0.1          # recordings/server.js の待受アドレス（既定: localhost 限定）
#FFMPEG_PATH=/opt/homebrew/bin/ffmpeg   # ffmpeg を PATH 以外に置いている場合のみ

# --- ポート（任意） --------------------------------------------------------
# go2rtc の API/UI ポート(1984)は env 化していません（フロントが :1984 を参照）。
# recordings のポートを変える場合は server.js 起動時に PORT を渡します:
#   PORT=4000 node recordings/server.js
